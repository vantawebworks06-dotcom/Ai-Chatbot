# Copy this file to .env.local and fill in the values.
# Never commit .env.local. It is ignored by .gitignore.

# --- Supabase (Dashboard > Project Settings > API Keys) ----------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# Publishable (or legacy "anon") key: safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-or-anon-key>
# Secret (or legacy "service_role") key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=<your-secret-or-service-role-key>

# --- AI: Google Gemini (https://aistudio.google.com > Get API key) -----------
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
AI_PROVIDER=gemini
GEMINI_API_KEY=<your-gemini-api-key>
# Optional. Defaults to gemini-3.5-flash-lite (fast, stable).
# For stronger reasoning try gemini-4-hydrogen.
# AI_MODEL=gemini-3.5-flash-lite

# --- Optional: vector search for large knowledge bases -----------------------
# Without this, retrieval uses Postgres full-text search, which works well for
# most small and medium knowledge bases.
# EMBEDDINGS_PROVIDER=voyage
# VOYAGE_API_KEY=<your-voyage-api-key>

# --- Optional: public URL used in the install snippet ------------------------
# Defaults to the URL the dashboard is opened on.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
